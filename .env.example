# Contact, proposal and ad-lead (/api/lead) emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=contactus@ardncloudsolutions.com
NEXT_PUBLIC_BASE_URL=https://ardncloudsolutions.com

# Supabase project "ardn-website" (org ARDN Cloud Solutions). Holds the
# calculator entries posted to /api/proposal and everything behind the
# private proposal pages (src/lib/proposals/store.ts). The publishable key
# is enough; the tables are reachable only through the database functions.
SUPABASE_URL=https://lrvubzneyudffztlzlmi.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Proposal pages (/proposals/<client>)
PROPOSALS_DB_KEY=        # must equal proposal_settings.db_key in the database
PROPOSALS_SECRET=        # signs codes and session cookies; any long random string
PROPOSALS_NOTIFY_EMAIL=  # where "proposal opened" alerts go (default: CONTACT_RECEIVER_EMAIL)

# Ad landing pages (/start/<hook>): leads are routed and emailed by /api/lead.
# Set to "true" to also mirror each lead to the arndai hub (best effort).
FUNNEL_HUB_ENABLED=false
NEXT_PUBLIC_FUNNEL_API_BASE=https://ardnai.com
